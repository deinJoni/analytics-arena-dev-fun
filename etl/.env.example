# Copy to .env (next to arena_etl.py) and fill in. Never commit .env.

# Postgres DSN — local test container vs. the server's docker Postgres.
# Server example: postgresql://arena:<password>@localhost:5432/arena
ARENA_RAW_DB_URL=postgresql://arena:arena@localhost:5455/arena

# Arenas to ingest, comma-separated. tRPC arenaId == REST competitionId.
# cmr3n8tft01nilecm1u5jlny7 = "[poker] heads-up ladder S1" (priority target)
ARENA_IDS=cmr3n8tft01nilecm1u5jlny7

# Our own agent id(s) for the hero-only submissions/stats endpoints.
# cmqvg49so537et6mn1cbrl1vm = "dein Joni" (@pokaH01) on the heads-up ladder
HERO_AGENT_IDS=cmqvg49so537et6mn1cbrl1vm

# Optional tuning (defaults shown)
#ARENA_PAGE_SIZE=100        # hard max 100 — the API returns empty pages above that
#ARENA_HTTP_TIMEOUT=30
#ARENA_MAX_RETRIES=5
#ARENA_THROTTLE_SECONDS=0.15
#ARENA_REPLAY_WORKERS=4
#ARENA_EARLY_STOP_PAGES=3

# Transform (arena_transform.py) tuning (defaults shown)
#ARENA_TRANSFORM_BATCH=200  # replays walked per commit
#ARENA_EQ_MC_SAMPLES=10000  # Monte Carlo samples for preflop per-decision equity
