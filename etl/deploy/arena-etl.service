# /etc/systemd/system/arena-etl.service
# Adjust User/paths to the server. Pair with arena-etl.timer.
[Unit]
Description=Arena raw-data ingestion (dev.fun -> Postgres raw schema)
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
User=jonas
WorkingDirectory=/opt/arena-etl
# .env next to the script is read automatically; EnvironmentFile also works:
#EnvironmentFile=/opt/arena-etl/.env
ExecStart=/opt/arena-etl/.venv/bin/python /opt/arena-etl/arena_etl.py run
# A full backfill can take a while; incremental runs finish in seconds.
TimeoutStartSec=6h
