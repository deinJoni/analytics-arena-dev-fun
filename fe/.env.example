# Postgres connection string (read-only role recommended: app_readonly, SELECT on mart.* only).
# On Vercel: set this as an Environment Variable (Production/Preview scoped), never NEXT_PUBLIC_.
# Point it at the transaction pooler (PgBouncer/Supavisor), not Postgres directly.
DATABASE_URL=postgresql://app_readonly:CHANGE_ME@your-pooler-host:6432/arena

# Server CA certificate (PEM contents, newlines as \n or a multiline var).
# When set, the pool connects with sslmode=verify-full semantics:
#   ssl: { ca, rejectUnauthorized: true }
# Leave unset for local dev against the docker container (no TLS).
# DATABASE_SSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Set to "require" to enable TLS without CA pinning (encrypts but does not
# authenticate the server — prefer DATABASE_SSL_CA in production).
# DATABASE_SSL=require

# Competition scope applied server-side on every query (defaults to S1).
# ARENA_COMPETITION_ID=cmr3n8tft01nilecm1u5jlny7

# Max connections per pool instance (keep small on serverless; default 3).
# PGPOOL_MAX=3
